{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BatchDatabase": ""
  },
  "BatchSettings": {    
    "MaxFileSizeBytes": 10485760,    
    "AllowedExtensions": [ ".csv", ".txt" ],    
    "MaxRetryAttempts": 3,    
    "ChannelCapacity": 100
  }
}
